# (uncomment to add a dependency)
dependencies:
  - name: jquery
    version: 3.7.1
    src: htmlwidgets/lib/jquery
    script: jquery.min.js

  - name: jquery-ui
    version: 1.14.2
    src: htmlwidgets/lib/jquery-ui
    script: jquery-ui.min.js
    stylesheet: jquery-ui.min.css

  - name: pivottable
    version: 2.23.0
    src: htmlwidgets/lib/pivottable
    script: pivot.min.js
    stylesheet: pivot.min.css
